# =============================================================================
# I-ASCAP Environment Configuration
# Copy this file to .env and update with your actual values.
# =============================================================================

# ---- Application ----
DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/i_ascap
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20

# ---- Redis / Cache ----
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=auto  # "redis", "memory", or "auto" (try Redis, fallback to memory)

# ---- AI ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Frontend (public) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# No Mapbox token needed — using MapLibre with CARTO basemaps

# ---- Security ----
API_KEY=  # Optional admin key for /stats endpoint

# ---- CORS (comma-separated list) ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- Data Paths (Docker container paths) ----
DATA_DIR=/app/data
LINEAGE_CSV_PATH=/app/data/v1/district_lineage.csv

# ---- Analytics ----
BOOTSTRAP_ITERATIONS=1000
CONFIDENCE_LEVEL=0.95

# ---- Versioning ----
DATASET_VERSION=v1.5_harmonized
BOUNDARY_VERSION=2024-01-15
