{
  "venvPath": "./backend",
  "venv": "venv",
  "pythonVersion": "3.13",
  "typeCheckingMode": "basic",
  "extraPaths": [
    "./backend",
    "./db_export"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["."]
    },
    {
      "root": "scripts",
      "extraPaths": ["../backend"]
    },
    {
      "root": "db_export"
    }
  ]
}
